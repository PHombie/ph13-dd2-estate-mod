<Project>
  <!-- Where your own Darkest Dungeon II is installed. If it is somewhere else, put a file
       Directory.Build.props.user beside this one (it is not in git):
         <Project><PropertyGroup><GameDir>X:\...\Darkest Dungeon® II</GameDir></PropertyGroup></Project>
       or pass -p:GameDir="..." to dotnet build. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Darkest Dungeon® II</GameDir>
    <ManagedDir>$(GameDir)\Darkest Dungeon II_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <PluginDeployDir>$(BepInExDir)\plugins\DD2Estate</PluginDeployDir>
  </PropertyGroup>
</Project>
